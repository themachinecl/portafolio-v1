---

<section class="menu-screen" aria-labelledby="menu-title">
  <aside class="main-menu" aria-label="Main portfolio menu">
    <a class="main-menu__logo" href="/" aria-label="Juan Paulo Rubilar Fontt home">
      <img
        src="/images/juan-paulo-logo.webp"
        alt="Juan Paulo Rubilar Fontt - Architect of Digital Empires"
        width="440"
        height="225"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="menu-tiles" aria-label="Professional menu">
      {menuItems.map((item, index) => (
        <button
          class:list={['menu-tile', index === 0 && 'is-active']}
          type="button"
          data-panel={item.id}
          aria-controls={`panel-${item.id}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="menu-tile__art">
            <img src={item.panel} alt="" width="768" height="341" loading="eager" decoding="async" />
          </span>
          <span class="menu-tile__label">{item.label}</span>
        </button>
      ))}
    </nav>

    <div class="menu-divider" aria-hidden="true">
      <span></span>
    </div>

    <nav class="secondary-menu" aria-label="Alliance links">
      <a class="menu-button" href="https://www.linkedin.com/in/juanpaulorf/" target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="menu-button" href="https://github.com/themachinecl" target="_blank" rel="noreferrer">GitHub</a>
      <a class="menu-button" href="mailto:contacto@juanpaulo.dev">Email</a>
      <a class="menu-button" href="/Juan_Paulo_Rubilar_Fontt_CV_2026.pdf" download>CV</a>
    </nav>
  </aside>

  <div class="command-area" aria-live="polite">
    <article class="command-panel is-active" id="panel-chronicle" data-content-panel="chronicle">
      <span class="panel-kicker">Chronicle</span>
      <h1 id="menu-title">Juan Paulo Rubilar Fontt</h1>
      <p class="panel-subtitle">Senior Software Engineer · Technical Lead · Angular & React Specialist</p>
      <p>
        13+ years of experience building enterprise software across banking, health, government, retail and logistics.
        Experienced in architecture, technical leadership, frontend, backend, cloud platforms and collaboration with data
        science teams.
      </p>
      <div class="achievement-grid" aria-label="Professional focus">
        <span>Architecture</span>
        <span>Technical Leadership</span>
        <span>Frontend</span>
        <span>Backend</span>
        <span>Cloud</span>
        <span>Data Science Collaboration</span>
      </div>
    </article>

    <article class="command-panel" id="panel-arsenal" data-content-panel="arsenal" hidden>
      <span class="panel-kicker">Arsenal</span>
      <h2>Arsenal of Technologies</h2>
      <div class="arsenal-grid">
        {arsenal.map((group) => (
          <section class="arsenal-card">
            <img src={group.icon} alt="" width="34" height="34" loading="lazy" decoding="async" />
            <h3>{group.category}</h3>
            <ul>
              {group.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </article>

    <article class="command-panel" id="panel-campaigns" data-content-panel="campaigns" hidden>
      <span class="panel-kicker">Campaigns</span>
      <h2>Imperial Campaigns</h2>
      <div class="campaign-list">
        {campaigns.map((campaign) => (
          <section class="campaign-chapter">
            <span>{campaign.chapter}</span>
            <h3>{campaign.title}</h3>
            <p>{campaign.text}</p>
          </section>
        ))}
      </div>
    </article>

    <article class="command-panel" id="panel-conquests" data-content-panel="conquests" hidden>
      <span class="panel-kicker">Conquests</span>
      <h2>Great Victories</h2>
      <div class="conquest-grid">
        {conquests.map((project, index) => (
          <section class="conquest-card">
            <img src={index % 2 === 0 ? '/icons/fortress.svg' : '/icons/imperial-map.svg'} alt="" width="38" height="38" />
            <span>Imperial Campaign</span>
            <h3>{project}</h3>
            <p>Strategic enterprise delivery with scalable architecture, reliable integrations and production-focused execution.</p>
          </section>
        ))}
      </div>
    </article>

    <article class="command-panel" id="panel-seals" data-content-panel="seals" hidden>
      <span class="panel-kicker">Seals</span>
      <h2>Imperial Seals</h2>
      <div class="seal-grid">
        {seals.map((seal) => (
          <section class="seal-card">
            <img src="/icons/crown.svg" alt="" width="34" height="34" loading="lazy" decoding="async" />
            <span>{seal}</span>
          </section>
        ))}
      </div>
    </article>

    <article class="command-panel" id="panel-alliance" data-content-panel="alliance" hidden>
      <span class="panel-kicker">Alliance</span>
      <h2>Form an Alliance</h2>
      <p>Open to senior frontend, technical leadership and enterprise architecture conversations.</p>
      <div class="alliance-actions">
        <a class="menu-button" href="https://www.linkedin.com/in/juanpaulorf/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="menu-button" href="https://github.com/themachinecl" target="_blank" rel="noreferrer">GitHub</a>
        <a class="menu-button" href="mailto:contacto@juanpaulo.dev">Email</a>
        <a class="menu-button" href="/Juan_Paulo_Rubilar_Fontt_CV_2026.pdf" download>Descargar CV</a>
      </div>
    </article>
  </div>

  <aside class="top-hud" aria-label="Profile panel">
    <div class="top-hud__icons" aria-hidden="true">
      <span><img src="/icons/gear.svg" alt="" /></span>
      <span><img src="/icons/scroll.svg" alt="" /></span>
    </div>
    <div class="top-hud__avatar">JP</div>
    <div class="top-hud__identity">
      <strong>JUAN PAULO RUBILAR FONTT</strong>
      <span>Senior Software Engineer</span>
    </div>
  </aside>

  <article class="campaign-banner" aria-label="Active campaign">
    <p>Active Campaign</p>
    <h2>Auto Allocation Japan</h2>
    <ul>
      <li>Angular 19</li>
      <li>Microfrontends</li>
      <li>Azure</li>
      <li>NestJS</li>
      <li>SQL Server</li>
      <li>Data Science</li>
    </ul>
  </article>

  <p class="version-label">PORTFOLIO 2026 · IMPERIAL CHRONICLE</p>
</section>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-panel]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-content-panel]')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let activePanel = document.querySelector<HTMLElement>('[data-content-panel].is-active');
  let transitionInProgress = false;

  const openPanel = (panelId: string) => {
    const nextPanel = panels.find((panel) => panel.dataset.contentPanel === panelId);

    if (!nextPanel || nextPanel === activePanel || transitionInProgress) {
      return;
    }

    buttons.forEach((button) => {
      const active = button.dataset.panel === panelId;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    if (reduceMotion || !window.gsap) {
      panels.forEach((panel) => {
        const active = panel === nextPanel;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });
      activePanel = nextPanel;
      return;
    }

    transitionInProgress = true;
    const gsap = window.gsap;
    const currentPanel = activePanel;

    gsap.killTweensOf([currentPanel, nextPanel]);
    nextPanel.hidden = false;
    nextPanel.classList.add('is-active', 'is-entering');
    gsap.set(nextPanel, { autoAlpha: 0, y: 18, scale: 0.98 });

    gsap.to(currentPanel, {
      autoAlpha: 0,
      y: -8,
      duration: 0.18,
      ease: 'power2.out',
      onComplete: () => {
        if (currentPanel) {
          currentPanel.hidden = true;
          currentPanel.classList.remove('is-active');
          gsap.set(currentPanel, { clearProps: 'all' });
        }
      },
    });

    gsap.to(nextPanel, {
      autoAlpha: 1,
      y: 0,
      scale: 1,
      duration: 0.35,
      ease: 'power2.out',
      delay: 0.04,
      onComplete: () => {
        nextPanel.classList.remove('is-entering');
        gsap.set(nextPanel, { clearProps: 'opacity,visibility,transform' });
        activePanel = nextPanel;
        transitionInProgress = false;
      },
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      if (button.dataset.panel) {
        openPanel(button.dataset.panel);
      }
    });
  });
</script>
