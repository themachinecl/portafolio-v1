---
const primaryItems = [
  { label: 'Chronicle', image: '/icons/royal-archive.svg' },
  { label: 'Campaigns', image: '/icons/imperial-map.svg', badge: 'NEW' },
  { label: 'Technologies', image: '/icons/engineering-workshop.svg' },
  { label: 'Conquests', image: '/icons/castle.svg' },
];

const secondaryItems = ['Alliance', 'LinkedIn', 'GitHub', 'Email'];
---

<section class="menu-screen" aria-labelledby="menu-title">
  <aside class="main-menu" aria-label="Main portfolio menu">
    <a class="main-menu__logo" href="/" aria-label="Juan Paulo Rubilar Fontt home">
      <img
        src="/images/juan-paulo-logo.webp"
        alt="Juan Paulo Rubilar Fontt - Architect of Digital Empires"
        width="440"
        height="225"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="menu-tiles" aria-label="Primary menu">
      {primaryItems.map((item) => (
        <a class="menu-tile" href="#">
          {item.badge && <span class="menu-tile__badge">{item.badge}</span>}
          <span class="menu-tile__art">
            <img src={item.image} alt="" width="64" height="64" loading="eager" decoding="async" />
          </span>
          <span class="menu-tile__label">{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="menu-divider" aria-hidden="true">
      <span></span>
    </div>

    <nav class="secondary-menu" aria-label="Secondary menu">
      {secondaryItems.map((item) => (
        <a class="menu-button" href="#">{item}</a>
      ))}
    </nav>

    <a class="menu-button menu-button--wide" href="/Juan_Paulo_Rubilar_Fontt_CV_2026.pdf" download>
      Download CV
    </a>
  </aside>

  <div class="top-hud" aria-label="Profile panel">
    <div class="top-hud__icons" aria-hidden="true">
      <span>⚙</span>
      <span>✉</span>
    </div>
    <div class="top-hud__avatar">JP</div>
    <div class="top-hud__identity">
      <strong>JUAN PAULO RUBILAR FONTT</strong>
      <span>Architect of Digital Empires</span>
    </div>
  </div>

  <article class="campaign-banner" aria-labelledby="menu-title">
    <p>Featured Campaign</p>
    <h1 id="menu-title">Auto Allocation Japan</h1>
    <span>Angular · NestJS · Azure · Microfrontends</span>
  </article>

  <p class="version-label">PORTFOLIO 2026 · SENIOR FRONTEND ENGINEER</p>
</section>
